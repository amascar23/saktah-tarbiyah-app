{
  "expo": {
    "name": "Saktah Tarbiyah",
    "slug": "saktah-tarbiyah-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-saktah.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo-saktah.png",
      "resizeMode": "contain",
      "backgroundColor": "#f4efdc"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-saktah.png",
        "backgroundColor": "#f4efdc"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
